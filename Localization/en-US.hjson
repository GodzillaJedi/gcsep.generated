		Items: {
			AddonsForce: {
				DisplayName: Force of Additions
				Tooltip:
					'''
					[i:gcsep/ClamitasEnchant] Effects of Soul of Pyrogen, Hell Flare, and Clamitas Shellmet Armor
					[i:gcsep/FrozenEnchant] Effects of Frozen Armor
					[i:gcsep/IntergelacticEnchant] Effects of Influx Cluster and Intergelatic Armor
					[i:gcsep/MariviumEnchant] Effects of Wyrm Tooth Necklace, Holy Mantle and Marivinium Armor
					[i:gcsep/ShogunEnchant] Effects of Tendril Cursor Attachment, Splendor Jam, and Shogun Armor
					[i:gcsep/VoidFaquirEnchant] Effects of Reincarnation Badge and Void Faquir Armor
					[i:gcsep/VoidFaquirEnchant] Summons a Cruiser that follows your cursor 
					[i:gcsep/SolynsSigil] Effects of Divine Wings, Portal Skirt, and Deific Touch
					'Bought the Season Pass for this one'
					'''
			}

			ClamitasEnchant: {
				DisplayName: Clamitas Enchantment
				Tooltip:
					'''
					[i:Clamity/ClamitasShellmet] Two Shellfishes assist you in combat
					[i:Clamity/SoulOfPyrogen] 10% increased melee and rogue damage
					True melee and stealth strikes summon spears from the depths of Hell
					[i:Clamity/HellFlare] All attacks and projectiles inflict Hellfire
					Grants immunity to On fire! and Hellfire
					Being above 75% life grants 10% increased crit chance
					Being below 25% life grants 10% increased damage reduction
					Grants resistance against cold attacks
					'Seas of Hell's tides now rises'
					'''
			}

			FrozenEnchant: {
				DisplayName: Frozen Enchantment
				Tooltip:
					'''
					[i:Clamity/FrozenHellstoneVisor] 20% increased true melee damage. 
					True melee attacks inflict Frostburn. 
					Enemies are more likely to target you
					Cannot be frozen.
					Press {0} to create an ice shield that parries attacks.
					Failing to parry will cause you to overcool.
					'Freeze Mother B****'
					'''
			}

			IntergelacticEnchant: {
				DisplayName: Intergelactic Enchantment
				Tooltip:
					'''
					[i:CatalystMod/IntergelacticHeadMelee] Four asteroid rings, knockback immunity and movement‑debuff immunity
					[i:CatalystMod/IntergelacticHeadRanged] Ranged attacks summon stars (30% damage)
					[i:CatalystMod/IntergelacticHeadMagic] Magic crits release starbursts, −20% mana cost and doubled potion mana
					[i:CatalystMod/IntergelacticHeadSummon] +4 minions, minions can crit and you launch stored asteroids
					[i:CatalystMod/IntergelacticHeadRogue] Steatlh strikes release an asteroid belt
					All attacks inflict [cbuff:CatalystMod/AstralBlight] 
					[i:CatalystMod/InfluxCluster] Press the [KEY] to dash towards the cursor as a violent nebula
					During the dash, you are fully immune to damage
					50 second cooldown
					'A galaxies worth of gel at your fingertips'
					'''
			}

			MariviumEnchant: {
				DisplayName: Marivinium Enchantment
				Tooltip:
					'''
					[i:CalamityEntropy/MariviniumHelmet] +20% Melee Damage Reduce
					+10 Minion Slot
					+100% Summon Damage
					+5% Summon Crit
					+10% Damage Reduce
					+135 Rogue Stealth
					When standing, increase life regen
					Immunity to most debuffs
					When using true melee weapons, +10% Damage reduce and 15 defense
					When using a whip, enhance summoner attributes
					Stealth strike has a probability of causing an water explosion
					Obtain 2 layers of shields, which will take 30 seconds to recover after being shattered
					After shield shattered, treat 100 health points and +50% damage for 10 seconds
					[i:CalamityEntropy/WyrmToothNecklace] +25% Damage
					+100 Armor penetration
					+15% Crit Chance
					[i:CalamityEntropy/HolyMantle] Provide you with a Holy Shield that can withstand damage once
					This effect has a 120 second cooldown time
					Loot from hallow monsters
					'Abyssal Strength'
					'''
			}

			ShogunEnchant: {
				DisplayName: Shogun Enchantment
				Tooltip:
					'''
					[i:CalamityHunt/ShogunHelm] 17% increased damage and +5 max minions
					{$CommonItemTooltip.FlightAndSlowfall}
					Wearing any wings overrides this flight
					{$CommonItemTooltip.PressDownToHover}
					Allows the ability to dash and enhances other dashes
					Hold DOWN to fastfall
					Increases jump speed 
					Grants immunity to many endgame and movement-based debuffs
					[i:CalamityHunt/TendrilCursorAttachment] Attaches hanging chromatic tendrils to your mouse cursor
					The amount of tendrils depends on the slot this item is placed in
					[i:CalamityHunt/SplendorJam] Activates the Stress Bar
					Stress builds up passively, though standing close to enemies speeds up the rate at which it increases
					You emit light that scales with your Stress level
					Grants a Spectacle at 0%, 25%, 50%, 75%, and 100% Stress
					At 25% Stress your weapons will produce explosions
					At 75% Stress your explosions will become larger and deal more damage
					Double tap DOWN while Stress is above 25% to enter Malice Mode
					Malice Mode significantly increases your damage, as well as granting flat damage, armor penetration, and critical strike
					These boosts and their duration scale with the amount of stress you have
					'Anxious yet Honorable'
					'''
			}

			SolynsSigil: {
				DisplayName: Solyns Sigil
				Tooltip:
					'''
					[i:NoxusBoss/DeificTouch] Reveals paradise behind your cursor
					[i:NoxusBoss/PortalSkirt] Summons a portal at your waist
					[i:NoxusBoss/DivineWings] Horizontal speed: 16.67
					Acceleration multiplier: 3.7
					Sublime vertical speed
					Flight time: ∞
					'Learner Terrarian has now become the Master'
					'''
			}

			VoidFaquirEnchant: {
				DisplayName: Void Faquir Enchantment
				Tooltip:
					'''
					+20 Armor Penetration
					Hitting the target will increase void energy
					Provides movement and flight speed bonuses based on the amount of void energy
					Press the armor bonus key to activate Void energy Summon a Void Wraith to assist in battle and fly indefinitely for 10 seconds
					Void Wrairh damage type depends on the weapon in hand
					[i:CalamityEntropy/VoidFaquirDevourerHelm] +24% Attack Speed
					+10% Damage Reduce
					Accumulates more void energy when hitting targets.
					[i:CalamityEntropy/VoidFaquirShadowHelm] Projectile damage increases with time
					[i:CalamityEntropy/VoidFaquirCosmosHood] -25% Mana Cost
					Magic Projectiles hits enemies will reduce your Mana Sickness by 0.5s
					[i:CalamityEntropy/VoidFaquirLurkerMask]+15% movement speed
					+135 Max Stealth
					Stealth strikes will accumulate more void energy
					[i:CalamityEntropy/VoidFaquirEvokerHelm] +7 Max Minions
					+80% Summon Damage
					Summon a Void Symbiont fight for you
					[i:CalamityEntropy/ReincarnationBadge] Press [KEY] to Ascend.
					In this state, you are not affected by gravity, and push away surrounding projectiles
					Press 'Cruiser Attack' to summon a Void Cruiser to follow your cursor
					'Wrath from the void'
					'''
			}

			AerospecEnchantEx: {
				DisplayName: Aerospec Enchantment EX
				Tooltip: ""
			}

			AstralEnchant: {
				DisplayName: Astral Enchantment
				Tooltip:
					'''
					[i:CalamityMod/AstralHelm] Increases your max number of minions by 3
					10% increased damage and critical strike chance
					Detects nearby creatures, enemy projectiles, danger sources, and treasure
					Whenever you crit an enemy, a barrage of stars will rain down
					This effect has a 1 second cooldown before it can trigger again
					[i:CalamityMod/InterstellarStompers] 6% increased movement speed, 20% increased jump speed, and negates fall damage
					Hold ▼ Down to increase your maximum fall speed
					Pressing Interstellar Stompers Hotkey while midair charges up a superspeed slam over 0.33 seconds
					While falling, you ram through enemies and don't take contact damage
					Once you hit the ground, you create an explosion at your feet
					The explosion scales in both damage and size the longer you slam for
					Temporary 40% increased jump speed after slamming into the ground
					[i:CalamityMod/UrsaSergeant] Attacks maul enemies with astral claw stripes
					Taking damage reduces the cooldown, but inflicts you with Astral Infection
					Enemy kills also reduce the cooldown
					Swipes will be translucent and silent if visibility is disabled
					'Walk on Astral shores'
					'''
			}


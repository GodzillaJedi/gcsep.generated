			UmbraphileEnchant: {
				DisplayName: Umbraphile Enchantment
				Tooltip:
					'''
					[i:CalamityMod/UmbraphileHood] +110 maximum stealth
					Rogue weapons have a chance to create explosions on hit
					Stealth strikes always create an explosion
					[i:CalamityMod/VampiricTalisman] Rogue critical strikes steal enemy life
					Stealth strikes grant 15% critical strike chance and increased lifesteal to non-stealth strikes for 10 seconds
					Stealth strikes inflict Heavy Bleeding and Armor Crunch, and deal 8% more damage
					[i:CalamityMod/CoinofDeceit] Stealth strikes only expend 90% of your max stealth
					6% increased rogue crit chance
					'The power of the Shadows ar yours'
					'''
			}

			VictideEnchantEx: {
				DisplayName: Victide Enchantment EX
				Tooltip: ""
			}

			WulfrumEnchantEx: {
				DisplayName: Wulfrum Enchantment EX
				Tooltip:
					'''
					[i:CalamityMod/WulfrumHat]{$CommonItemTooltip.PercentIncreasedSummonDamage}
					Comes equipped with hair extensions
					SetBonus:
					[c/{0}:Wulfrum Bastion - {1} to equip a power armor, costing one] [i:CalamityMod/WulfrumMetalScrap] [c/{0}:{$Items.Materials.WulfrumMetalScrap.DisplayName}]
					[c/6EC05D:While active, you can only use the integrated fusion cannon, but your defensive stats are increased]
					[c/6EC05D:The armor lasts up to {2} {^2:second;seconds}, but each hit loses {3} {^3:second;seconds} of duration]
					[c/BEBEBE:Hold Shift to see the stats of the fusion cannon] 
					[i:CalamityMod/WulfrumAcrobaticsPack] Provides a wulfrum slingshot grappling hook
					This slingshot's stats scale with your equipped hook
					If the hook has special effects, the slingshot also benefits from them
					The slingshot allows for advanced rope-swinging physics
					Hold {$Key.UP} or {$Key.DOWN} to retract or extend the slingshot's rope
					Automatically grapples nearby walls if a lethal fall is detected
					This safety feature won't activate if {$Key.DOWN} is held
					8% increased movement speed
					[i:CalamityMod/TrinketofChi] Increases damage reduction by 8% if you avoid taking damage for 10 seconds
					This buff expires on hit
					+1 HP/s life regen for you and your teammates
					'''
				SetBonus:
					'''
					[c/{0}:Wulfrum Bastion - {1} to equip a power armor, costing one] [i:CalamityMod/WulfrumMetalScrap] [c/{0}:{$Items.Materials.WulfrumMetalScrap.DisplayName}]
					[c/6EC05D:While active, you can only use the integrated fusion cannon, but your defensive stats are increased]
					[c/6EC05D:The armor lasts up to {2} {^2:second;seconds}, but each hit loses {3} {^3:second;seconds} of duration]
					[c/BEBEBE:Hold Shift to see the stats of the fusion cannon]
					'''
			}

			AnnihilationForce: {
				DisplayName: Force of Annihlation
				Tooltip:
					'''
					[i:gcsep/EmpyreanEnchant] Effects of Dark Heart, Dark Matter Sheath and Empyrean Armor
					[i:gcsep/PlagueReaperEnchant] Effects of Plague Fuel Pack, Alchemical Decanter, and Plague Reaper Armor
					[i:gcsep/PlaguebringerEnchant] Effects of The Bee and Plaguebringer Armor
					[i:gcsep/PlaguebringerEnchant] Summons [cbuff:CalamityMod/ViriliBuff] to fight for you
					[i:gcsep/FearfallenEnchant] Effects of Spectral Veil, Nightfallen and Fearmonger Armors
					[i:gcsep/BrimflameEnchant] Effects of Flame-Licked Shell, Abaddon, Slagspitter Pauldron, Void of Calamity, Sigil of Calamitas, and Brimflame Armor
					'''
			}

			DesolationForce: {
				DisplayName: Force of Desolation
